    "nanostores": "1.5.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@showcase/contracts": "1.0.0",
    "@types/node": "24.10.1",
    "justcore": "file:../../../..",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
