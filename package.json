{
  "version": "3.0.0",
  "name": "justcore",
  "main": "dist/justcore.umd.js",
  "umd:main": "dist/justcore.umd.js",
  "jsnext:main": "dist/justcore.module.js",
  "module": "dist/justcore.module.js",
  "typings": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/valentin-lozev/justcore.git"
  },
  "license": "MIT",
  "author": "Valentin Lozev",
  "keywords": [
    "justcore",
    "modular architecture",
    "modules management",
    "scalable applications",
    "front-end",
    "typescript"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.0",
    "@types/jasmine": "7.0.0",
    "jasmine": "7.0.0",
    "rollup": "4.64.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','.build']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup -c",
    "pretest": "node -e \"for (const d of ['.test-build']) require('fs').rmSync(d,{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "jasmine --config=jasmine.json",
    "test:package": "tsc -p tests/package/tsconfig.json && node tests/package/smoke.mjs",
    "docs": "npm --prefix tools/docs ci && npm --prefix tools/docs run build"
  }
}
